# Keyboard shortcuts, expressed as KeyboardEvent.code values.
# Copy this file to `.env` (or `.env.local` to override locally) and edit the keys.
# Examples: Space, Enter, Backspace, KeyA, ArrowLeft, BracketLeft, Slash, Escape.
# Shift and Ctrl/⌘ are fixed modifiers layered on top of these keys.
# Empty values fall back to the defaults below.
# Restart the dev server after changing these.

VITE_SHORTCUT_PLAY_PAUSE=Space
VITE_SHORTCUT_ANNOTATE=Enter
VITE_SHORTCUT_UNDO=Backspace
VITE_SHORTCUT_SHIFT_EARLIER=BracketLeft
VITE_SHORTCUT_SHIFT_LATER=BracketRight
VITE_SHORTCUT_DELETE=Delete
VITE_SHORTCUT_SEEK_BACK=ArrowLeft
VITE_SHORTCUT_SEEK_FORWARD=ArrowRight
VITE_SHORTCUT_SELECT_UP=ArrowUp
VITE_SHORTCUT_SELECT_DOWN=ArrowDown
VITE_SHORTCUT_DESELECT=Escape
VITE_SHORTCUT_HELP=Slash
